# Translator — переменные окружения
# Скопируйте этот файл в .env и заполните реальными значениями.
# .env в приоритете над config.yaml для ВСЕХ параметров.

# ── API-ключи ────────────────────────────────────────────
# Gladia STT + Translation (обязательно)
GLADIA_API_KEY=your_gladia_key_here

# Groq Cloud API для генерации подсказок (бесплатный тир)
# https://console.groq.com/keys
LLM_API_KEY=your_groq_key_here
LLM_BASE_URL=https://api.groq.com/openai/v1

# ── LLM-параметры ───────────────────────────────────────
# Максимальное количество выходных токенов (0 = безлимит)
LLM_MAX_TOKENS=1024
# Модель: openai/gpt-oss-20b — быстрая не-reasoning модель Groq (free tier)
LLM_MODEL=openai/gpt-oss-20b

# ── Аудио ────────────────────────────────────────────────
# Устройства (пусто = системные по умолчанию)
# LOOPBACK_DEVICE=CABLE Input (VB-Audio Virtual Cable)
# MIC_DEVICE=Microphone (Realtek High Definition Audio)

# Сохранение аудио на диск (true/1/yes)
SAVE_AUDIO=false

# ── Debug ────────────────────────────────────────────────
# Режим ручного ввода текста в overlay (отладка без транскрибатора):
# кликабельное окно + поле ввода; введённая строка идёт как реплика собеседника.
# Ответ генерируется для вопросов и побудительных фраз интервьюера: строка с "?"
# или начинающаяся с англ. вопросного слова / побудительной фразы (tell me,
# tell us, introduce yourself, walk me, walk us, walk through, share, please …)
# (см. translator.IsQuestion и docs/UI.md).
# DEBUG_INPUT=1

# ── Оверлей (UI) ─────────────────────────────────────────
# Размер окна в пикселях (по умолчанию 800×650)
OVERLAY_WIDTH=800
OVERLAY_HEIGHT=650

# ── Языки ────────────────────────────────────────────────
# Язык оригинала (ISO 639-1). По умолчанию en.
# SOURCE_LANG=en
# Язык перевода Gladia и подсказок LLM (ISO 639-1). По умолчанию ru.
# TARGET_LANG=ru

# ── System prompt (правила генерации ответа) ─────────────
# Путь к файлу шаблона (относительно рабочего каталога). Правки применяются
# без перекомпиляции — файл читается на старте.
# Плейсхолдеры {{SRC_TAG}}/{{TGT_TAG}} подставляются из SOURCE_LANG/TARGET_LANG
# в верхнем регистре. Если файла нет — он создаётся при старте из встроенного
# дефолта и работа продолжается. Пустой путь, нечитаемый файл или неизвестный
# плейсхолдер — ошибка старта.
# SYSTEM_PROMPT_FILE=candidate_context/system_prompt.md

# ── Логи ─────────────────────────────────────────────────
# LOG_DIR=./logs

# Уровень логирования: debug, info, warn, error (по умолчанию info — без вывода в консоль)
# Консольный вывод включается только при debug.
# LOG_LEVEL=debug

# ── Контекст кандидата (база CV) ─────────────────────────
# Путь к текстовому файлу с фактами кандидата (база CV). Файл расширяемый —
# добавляйте туда дополнительную информацию о кандидате (факты, проекты, технологии).
# CANDIDATE_CONTEXT_FILE=candidate_context.md

# ── Candidate context — fact-level retrieval ─────────────
# Включение локального lexical retrieval (пусто = legacy CANDIDATE_CONTEXT_FILE):
# CANDIDATE_CONTEXT_DIR=candidate_context
# Бюджет фактов в токенах (по умолчанию 2000):
# CANDIDATE_CONTEXT_MAX_TOKENS=2000
# Бюджет профиля в токенах (по умолчанию 150):
# CANDIDATE_CONTEXT_MAX_PROFILE_TOKENS=150
# Минимальный lexical score (по умолчанию 0):
# CANDIDATE_CONTEXT_MIN_SCORE=0
# Максимум фактов в prompt (по умолчанию 5):
# CANDIDATE_CONTEXT_TOP_K=5

# ── Hints — подсказки-ответы ─────────────────────────────
# Каталог с заготовленными ответами на предсказуемые вопросы интервьюера
# (формат candidate_context: manifest.json + sections/; пусто = выключено):
# HINTS_DIR=hints
# Минимальный lexical score подсказки (подобран smoke-тестом: свои >= 62, посторонние <= 36.5):
# HINTS_MIN_SCORE=50
# Максимум подсказок на вопрос (по умолчанию 1):
# HINTS_TOP_K=1

# ── Conversation context (история интервью) ──────────────
# Максимум turns в контексте (по умолчанию 6).
# CONVERSATION_RECENT_TURNS=6
# Лимит размера контекста в токенах (по умолчанию 4000).
# CONVERSATION_MAX_CONTEXT_TOKENS=4000
# CONVERSATION_AUTO_ANSWER=true  # false: вопросы копятся как метки, ответ по F1
